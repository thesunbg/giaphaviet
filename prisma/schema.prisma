generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id               String   @id @default(cuid())
  fullName         String
  birthDate             String?
  birthDateType         String?  @default("solar") // "solar" | "lunar"
  deathDate             String?
  deathDateType         String?  @default("solar") // "solar" | "lunar"
  isAlive               Boolean  @default(true)
  gender                String   // "male" | "female"
  generation            Int      @default(1)
  birthOrder            Int      @default(1)
  occupation            String?
  address               String?
  /// Quốc gia đang sinh sống (mặc định Việt Nam)
  country               String?  @default("Việt Nam")
  /// Tỉnh/thành phố đang sinh sống (theo 34 đơn vị hành chính sau sáp nhập 2025)
  province              String?
  biography             String?
  graveInfo             String?
  deathAnniversary      String?
  deathAnniversaryType  String?  @default("lunar") // "solar" | "lunar"
  notes                 String?
  photoUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentChildAsChild  ParentChild[] @relation("ChildRelation")
  parentChildAsParent ParentChild[] @relation("ParentRelation")
  marriagesAsSpouse1  Marriage[]    @relation("Spouse1Relation")
  marriagesAsSpouse2  Marriage[]    @relation("Spouse2Relation")
  events              Event[]
  photos              Photo[]
  account             User?
  postsOnBehalf       Post[]         @relation("PostOnBehalfOf")
  contributions       Contribution[] @relation("MemberContributions")

  @@index([generation])
  @@index([fullName])
  @@index([province])
}

/// Tài khoản đăng nhập (con cháu trong dòng họ).
/// Tách khỏi Member: người trong gia phả không bắt buộc có tài khoản.
model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  name         String
  passwordHash String
  role         String    @default("member") // "admin" | "editor" | "member"
  status       String    @default("pending") // "pending" | "active" | "blocked"
  avatarUrl    String?
  note         String?
  memberId     String?   @unique
  inviteCodeId String?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  member     Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  inviteCode InviteCode? @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)

  posts        Post[]        @relation("PostAuthor")
  comments     Comment[]     @relation("CommentAuthor")
  reactions    Reaction[]    @relation("ReactionUser")
  chatMessages ChatMessage[] @relation("ChatAuthor")
  uploadedPhotos Photo[]        @relation("PhotoUploader")
  albums         Album[]        @relation("AlbumCreator")
  funds          Fund[]         @relation("FundCreator")
  contributions  Contribution[] @relation("ContributionRecorder")

  @@index([status])
  @@index([role])
}

/// Mã mời do quản trị phát cho người trong họ để đăng ký tài khoản.
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  note        String?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  autoApprove Boolean   @default(false)
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  users User[]
}

/// Mã xem gia phả (chỉ xem) cho các cụ / người không lập tài khoản.
model ViewAccessCode {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String?
  isActive  Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParentChild {
  id               String @id @default(cuid())
  parentId         String
  childId          String
  relationshipType String @default("biological")

  parent Member @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  child  Member @relation("ChildRelation", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

model Marriage {
  id           String  @id @default(cuid())
  spouse1Id    String
  spouse2Id    String
  marriageDate String?
  divorceDate  String?
  isActive     Boolean @default(true)
  orderIndex   Int     @default(1)

  spouse1 Member @relation("Spouse1Relation", fields: [spouse1Id], references: [id], onDelete: Cascade)
  spouse2 Member @relation("Spouse2Relation", fields: [spouse2Id], references: [id], onDelete: Cascade)

  @@unique([spouse1Id, spouse2Id])
  @@index([spouse1Id])
  @@index([spouse2Id])
}

model Event {
  id           String   @id @default(cuid())
  /// Có thể bỏ trống: sự kiện chung của cả dòng họ (giỗ tổ, họp họ...)
  memberId     String?
  title        String
  date         String?
  calendarType String?  @default("solar") // "solar" | "lunar"
  description  String?
  location     String?
  createdAt    DateTime @default(now())

  member Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model Photo {
  id           String   @id @default(cuid())
  memberId     String?
  url          String
  caption      String?
  isProfile    Boolean  @default(false)
  uploadedById String?
  albumId      String?
  takenAt      String?
  createdAt    DateTime @default(now())

  member     Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("PhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  album      Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([albumId])
  @@index([createdAt])
}

/// Album ảnh của dòng họ (giỗ tổ 2025, họp họ, xây từ đường...)
model Album {
  id          String   @id @default(cuid())
  name        String
  description String?
  eventDate   String?
  coverUrl    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos    Photo[]
  createdBy User?   @relation("AlbumCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Một đợt đóng góp / quỹ của dòng họ
model Fund {
  id           String   @id @default(cuid())
  name         String
  description  String?
  year         Int?
  targetAmount Int?
  isOpen       Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contributions Contribution[]
  createdBy     User?          @relation("FundCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Một dòng trong sổ đóng góp
model Contribution {
  id              String   @id @default(cuid())
  fundId          String
  /// Người trong gia phả (nếu chọn được), có thể bỏ trống
  memberId        String?
  contributorName String
  amount          Int
  paidAt          String?
  method          String?  // "cash" | "transfer"
  note            String?
  recordedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fund       Fund    @relation(fields: [fundId], references: [id], onDelete: Cascade)
  member     Member? @relation("MemberContributions", fields: [memberId], references: [id], onDelete: SetNull)
  recordedBy User?   @relation("ContributionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([fundId])
  @@index([memberId])
}

/// Bài đăng trên feed dòng họ
model Post {
  id                 String   @id @default(cuid())
  authorId           String
  content            String
  images             String[] @default([])
  type               String   @default("post") // "post" | "announcement"
  /// Đăng thay mặt một người trong gia phả (vd: cháu đăng hộ cụ)
  onBehalfOfMemberId String?
  pinned             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  author         User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  onBehalfOf     Member?    @relation("PostOnBehalfOf", fields: [onBehalfOfMemberId], references: [id], onDelete: SetNull)
  comments       Comment[]
  reactions      Reaction[]

  @@index([createdAt])
  @@index([authorId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String   @default("heart")
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("ReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

/// Tin nhắn trong phòng chat chung của dòng họ
model ChatMessage {
  id        String   @id @default(cuid())
  authorId  String
  content   String
  createdAt DateTime @default(now())

  author User @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// Thông tin chung của dòng họ do quản trị viên khai báo (chỉ một bản ghi)
model SiteSetting {
  id             String   @id @default("default")
  familyName     String   @default("Dòng họ")
  treeTitle      String?
  ancestralHome  String?
  address        String?
  description    String?
  contactPhone   String?
  updatedAt      DateTime @updatedAt
}
