# ===== Database (PostgreSQL) =====
# Local:  postgresql://USER:PASSWORD@localhost:5432/giaphaviet?schema=public
# Docker: postgresql://postgres:postgres@db:5432/giaphaviet?schema=public
# Neon / Supabase / RDS: thêm ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/giaphaviet?schema=public"

# ===== Bảo mật =====
# Khóa ký cookie phiên đăng nhập. Đổi giá trị này sẽ đăng xuất mọi phiên.
# Tạo khóa mới: openssl rand -hex 32
AUTH_SECRET="thay-bang-khoa-ngau-nhien-32-byte"

# Mật khẩu đăng nhập trang quản trị /admin
ADMIN_PASSWORD="thay-bang-mat-khau-manh"
